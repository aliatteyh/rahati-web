# Rahati web — copy to .env.local and adjust as needed

# --- Required ---
# Backend Laravel API base (no trailing slash)
NEXT_PUBLIC_API_BASE=https://admin.rahatics.com
# Default zone used for public browsing (admin zone id)
NEXT_PUBLIC_DEFAULT_ZONE_ID=298e918a-4b3d-4ebd-8f60-12034574fa6c
# Public site URL (used for canonical / Open Graph / sitemap). Update on deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SEO / marketing (optional) ---
# Google Analytics 4 or Google Ads tag id, e.g. G-XXXXXXX or AW-XXXXXXXXX
# Google Tag Manager container (GTM-XXXXXXX), for Google Ads and other
# marketing tags. Do not add GA4 inside the container while the id below
# is also set, or every visitor is counted twice.
NEXT_PUBLIC_GTM_ID=

NEXT_PUBLIC_GTAG_ID=
# Google Search Console verification token (content value of the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Firebase phone-auth (optional; code has safe public defaults) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
